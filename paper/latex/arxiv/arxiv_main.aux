\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Order error, not magnitude, governs MPD's loss: (a) realized loss sits far below the \(n-\mathrm  {LIS}\) bound at every point; (b) the four error models collapse onto the Kendall-\(\tau \) axis.}}{9}{figure.caption.3}\protected@file@percent }
