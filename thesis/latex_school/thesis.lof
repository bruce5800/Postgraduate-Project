\contentsline {chapteratlist}{\numberline {3}Model, Algorithms, and Methodology}{13}{chapter.3}%
\contentsline {figure}{\numberline {3.1}{\ignorespaces Erdős--Rényi reproduction: the characteristic U-shape, greedy minima near \(c\approx 4.9\), non-greedy degradation as \(c\) grows.}}{19}{figure.3.1}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Random left-regular reproduction: the hard case at \(d=5\), Greedy \(\approx \) Ranking.}}{20}{figure.3.2}%
\contentsline {chapteratlist}{\numberline {4}The Unified Benchmark}{21}{chapter.4}%
\contentsline {figure}{\numberline {4.1}{\ignorespaces The consistency--robustness plane (the data of Table 4.1); dashed lines mark the advice-free floor, dotted the oracle ceiling. TestAndMatch sits nearest the ideal top-right corner.}}{25}{figure.4.1}%
\contentsline {chapteratlist}{\numberline {5}What Governs the Loss: Order Error and ACI's Bound}{26}{chapter.5}%
\contentsline {figure}{\numberline {5.1}{\ignorespaces Order error governs the loss: the realized loss lies far below ACI's \(n-\mathrm {LIS}\) bound (a) and collapses onto Kendall-\(\tau \) across all four error models (b).}}{27}{figure.5.1}%
\contentsline {chapteratlist}{\numberline {6}Test-and-Fallback in Depth}{29}{chapter.6}%
\contentsline {figure}{\numberline {6.1}{\ignorespaces The robustness envelope: blind FollowPrediction crashes below the advice-free floor as advice error grows; TestAndMatch stays on the upper envelope.}}{30}{figure.6.1}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Testing cost at borderline advice: a larger, more accurate prefix test makes the \emph {worse} decision under the worst-case-calibrated threshold.}}{31}{figure.6.2}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Recalibration removes the threshold pathology: misjudgement holds at zero at every prefix size, versus climbing toward \(1.0\) under the worst-case threshold.}}{32}{figure.6.3}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces The testing-wall frontier: as the baseline weakens (left), the \emph {potential} upside of perfect advice grows, but the upside a sublinear test can \emph {safely capture} stays near zero --- the empirical test's resolution sits far above the break-even margin wherever the upside exists.}}{33}{figure.6.4}%
\contentsline {chapteratlist}{\numberline {7}External Validity}{35}{chapter.7}%
\contentsline {figure}{\numberline {7.1}{\ignorespaces A real, cheap predictor (Wikipedia trace): the aggregated degree route survives staleness (b) because aggregation halves the order error (a); blind histogram-following decays.}}{36}{figure.7.1}%
\contentsline {figure}{\numberline {7.2}{\ignorespaces F1--F3 on six real graphs: naive MPD (red) dips below the Ranking floor everywhere; the structural augmentations (green/blue) stay flat.}}{38}{figure.7.2}%
\contentsline {chapteratlist}{\numberline {8}Exploratory Directions and Negative Results}{39}{chapter.8}%
\contentsline {figure}{\numberline {8.1}{\ignorespaces M0: with divergent features, rank-training beats regression on the matching ratio (left) despite a worse regression fit (right).}}{40}{figure.8.1}%
\contentsline {figure}{\numberline {8.2}{\ignorespaces M3 (Azure trace, real temporal features): rank- and MSE-trained predictors are indistinguishable --- the engineered divergence that powers rank-training does not arise.}}{41}{figure.8.2}%
\contentsline {figure}{\numberline {8.3}{\ignorespaces Serving SLO probe: a non-predictive policy matches the clairvoyant oracle to within a few percent --- foresight does not help.}}{43}{figure.8.3}%
\contentsline {chapteratlist}{\numberline {9}Application Case Study: AI-Inference Serving}{45}{chapter.9}%
\contentsline {figure}{\numberline {9.1}{\ignorespaces Capacity as robustness: blindly following the forecast crashes goodput --- deeper at ample capacity (\(c=8\)) --- while the adaptive test stays flat.}}{46}{figure.9.1}%
\contentsline {figure}{\numberline {9.2}{\ignorespaces Live load beats a stale forecast under dynamic service times (Azure LLM trace, 9683 arrivals, 8 topologies per point): the forecast-free balancer is within \(2\%\) of the offline optimum at every capacity, blind following loses up to 40 points, and the prefix test recovers most of it. Ratios are against an upper bound on the offline optimum, hence conservative.}}{47}{figure.9.2}%
\contentsline {figure}{\numberline {9.3}{\ignorespaces The cache-affinity reversal (Mooncake trace): stable placement beats reactive routing for KV-cache reuse.}}{48}{figure.9.3}%
