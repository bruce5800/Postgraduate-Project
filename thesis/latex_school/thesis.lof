\contentsline {chapteratlist}{\numberline {3}Model, Algorithms, and Methodology}{11}{chapter.3}%
\contentsline {figure}{\numberline {3.1}{\ignorespaces Erdős--Rényi reproduction: the characteristic U-shape, greedy minima near \(c\approx 4.9\), non-greedy degradation as \(c\) grows.}}{16}{figure.3.1}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Random left-regular reproduction: the hard case at \(d=5\), Greedy \(\approx \) Ranking.}}{17}{figure.3.2}%
\contentsline {chapteratlist}{\numberline {4}The Unified Benchmark}{18}{chapter.4}%
\contentsline {figure}{\numberline {4.1}{\ignorespaces The consistency--robustness plane (the data of Table 4.1). Horizontal axis: ratio under perfect advice. Vertical axis: ratio under the worst corruption level, the operational robustness of §3.4. Dashed lines mark the advice-free floor, dotted the oracle ceiling; TestAndMatch sits nearest the ideal top-right corner.}}{22}{figure.4.1}%
\contentsline {chapteratlist}{\numberline {5}What Governs the Loss: Order Error and What the Known Bound Does Not Say}{23}{chapter.5}%
\contentsline {figure}{\numberline {5.1}{\ignorespaces Order error governs the loss: the realized loss lies far below ACI's \(n-\mathrm {LIS}\) bound (a) and collapses onto Kendall-\(\tau \) across all four error models (b).}}{24}{figure.5.1}%
\contentsline {chapteratlist}{\numberline {6}Test-and-Fallback in Depth}{26}{chapter.6}%
\contentsline {figure}{\numberline {6.1}{\ignorespaces The robustness envelope: blind FollowPrediction crashes below the advice-free floor as advice error grows; TestAndMatch stays on the upper envelope.}}{27}{figure.6.1}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Testing cost at borderline advice: a larger, more accurate prefix test makes the \emph {worse} decision under the worst-case-calibrated threshold.}}{28}{figure.6.2}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Recalibration removes the threshold pathology: misjudgement holds at zero at every prefix size, versus climbing toward \(1.0\) under the worst-case threshold.}}{29}{figure.6.3}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces The testing-wall frontier. Horizontal axis: baseline strength \(\rho _{\mathrm {base}}\), swept by the number of request types (weaker baseline and larger \(r\) to the left). Vertical axis: consistency upside over the baseline. As the baseline weakens, the \emph {potential} upside of perfect advice grows, but the upside a sublinear test can \emph {safely capture} stays near zero --- the empirical test's resolution sits far above the break-even margin wherever the upside exists.}}{30}{figure.6.4}%
\contentsline {chapteratlist}{\numberline {7}External Validity}{32}{chapter.7}%
\contentsline {figure}{\numberline {7.1}{\ignorespaces The figure to remember from this chapter: a real, cheap predictor (Wikipedia trace) --- the aggregated degree route survives staleness (b) because aggregation halves the order error (a); blind histogram-following decays.}}{33}{figure.7.1}%
\contentsline {figure}{\numberline {7.2}{\ignorespaces F1--F3 on six real graphs, one panel per graph (axis ranges differ between panels --- the graphs' floors do too, so read each panel against its own dashed floor rather than across panels). Naive MPD (red) dips below the Ranking floor everywhere; the structural augmentations (green/blue) stay flat.}}{34}{figure.7.2}%
\contentsline {chapteratlist}{\numberline {8}Exploratory Directions and Negative Results}{36}{chapter.8}%
\contentsline {figure}{\numberline {8.1}{\ignorespaces M0: with divergent features, rank-training beats regression on the matching ratio (left) despite a worse regression fit (right).}}{37}{figure.8.1}%
\contentsline {figure}{\numberline {8.2}{\ignorespaces M3 (Azure trace, real temporal features): rank- and MSE-trained predictors are indistinguishable --- the engineered divergence that powers rank-training does not arise.}}{38}{figure.8.2}%
\contentsline {figure}{\numberline {8.3}{\ignorespaces Serving SLO probe: a non-predictive policy matches the clairvoyant oracle to within a few percent --- foresight does not help.}}{39}{figure.8.3}%
\contentsline {chapteratlist}{\numberline {9}Application Case Study: AI-Inference Serving}{42}{chapter.9}%
\contentsline {figure}{\numberline {9.1}{\ignorespaces Capacity as robustness (synthetic serving topology: 200 replicas, 40 request types of degree 8, 800 arrivals, 25 trials per point): blindly following the forecast crashes the competitive ratio --- deeper at ample capacity (\(c=8\)) --- while the adaptive test stays flat.}}{43}{figure.9.1}%
\contentsline {figure}{\numberline {9.2}{\ignorespaces Live load beats a stale forecast under dynamic service times (Azure LLM trace, 9683 arrivals, 8 topologies per point): the forecast-free balancer is within \(2\%\) of the offline optimum at every capacity, blind following loses up to 40 points, and the prefix test recovers most of it. Ratios are against an upper bound on the offline optimum, hence conservative.}}{44}{figure.9.2}%
\contentsline {figure}{\numberline {9.3}{\ignorespaces The cache-affinity reversal (Mooncake trace, 16 replicas, cache capacity swept from 200 to 4000 blocks): stable placement beats reactive routing for KV-cache reuse. The vertical axis is the KV-cache hit fraction, not a competitive ratio.}}{45}{figure.9.3}%
